msgstr "Basics"

#: catalog/lab/registry.py:6
msgid "Производительность"
msgstr "Performance"

#: catalog/lab/registry.py:6
msgid "Согласованность"
msgstr "Consistency"

#: catalog/lab/registry.py:6
msgid "Выполнение"
msgstr "Execution"

#: catalog/lab/registry.py:6
msgid "Адаптеры"
msgstr "Adapters"

#: catalog/lab/registry.py:6
msgid "Наблюдаемость"
msgstr "Observability"

#: catalog/lab/registry.py:6
msgid "Инфраструктура"
