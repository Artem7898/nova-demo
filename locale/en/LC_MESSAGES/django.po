msgid "Связанная модель инвалидирует результат"
msgstr "Updating the related model invalidates the result"

#: catalog/lab/runner.py:255
msgid "Независимое повторное чтение"
msgstr "Independent repeated read"

#: catalog/lab/runner.py:256
msgid "Повторное чтение получено из кэша"
msgstr "The repeated read is served from the cache"

#: catalog/lab/runner.py:257
msgid "Изменение списка не затронуло кэш"
msgstr "Changing the list did not affect the cache"

#: catalog/lab/runner.py:258
msgid "Модель изолирована"
msgstr "The model is isolated"

#: catalog/lab/runner.py:259
msgid "Вложенный JSON изолирован"
msgstr "Nested JSON is isolated"

#: catalog/lab/runner.py:260
msgid "select_related изолирован"
msgstr "select_related is isolated"

#: catalog/lab/runner.py:261
msgid "prefetch_related изолирован"
msgstr "prefetch_related is isolated"

#: catalog/lab/runner.py:304
msgid "Параллельные задачи изолированы"
msgstr "Concurrent tasks are isolated"

