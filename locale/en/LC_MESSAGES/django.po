#: catalog/lab/registry.py:25 templates/lab.html:7
msgid "Валидация модели"
msgstr "Model validation"

#: catalog/lab/registry.py:27
msgid "Измените цену или название. Nova проверит данные до записи в БД."
msgstr "Change the price or name. Nova validates the data before writing to the database."

#: catalog/lab/registry.py:33
msgid "Сериализация"
msgstr "Serialization"

#: catalog/lab/registry.py:35
msgid "Несохранённая модель, JSON, файл 4 КБ и преобразование Django ↔ Pydantic."
msgstr "An unsaved model, JSON, a 4 KB file, and Django ↔ Pydantic conversion."

#: catalog/lab/registry.py:40
msgid "Планировщик запросов"
msgstr "Query planner"

#: catalog/lab/registry.py:42
msgid "Сравните N+1 и план Nova на одинаковых моделях и связях."
msgstr "Compare N+1 queries with a Nova plan using the same models and relations."

#: catalog/lab/registry.py:50
msgid "Два чтения одного запроса: реальные SQL-счётчики и время каждого шага."
msgstr "Read the same query twice and inspect actual SQL counts and step timings."

#: catalog/lab/registry.py:55
msgid "Commit и rollback"
msgstr "Commit and rollback"

#: catalog/lab/registry.py:57
msgid "Изменение станет видимым после commit; rollback сохранит прежнее значение."
msgstr "A commit makes the change visible; a rollback preserves the previous value."

#: catalog/lab/registry.py:62
msgid "Связанные модели"
msgstr "Related models"

#: catalog/lab/registry.py:64
msgid "Изменение категории обновляет кэш запроса с select_related."
msgstr "Updating a category invalidates the cached select_related query."

#: catalog/lab/registry.py:69
msgid "Изоляция результата"
msgstr "Result isolation"

#: catalog/lab/registry.py:71
msgid "Изменение списка, модели, JSON и связи не должно менять сохранённый кэш."
msgstr "Changing the returned list, model, JSON, or relation must not alter the cached value."

#: catalog/lab/registry.py:78
msgid "Вложенные области, параллельные задачи и восстановление после исключения."
msgstr "Nested scopes, concurrent tasks, and restoration after an exception."

#: catalog/lab/registry.py:85
msgid "Настоящее асинхронное чтение модели через aget и aexists."
msgstr "Read a real model asynchronously with aget and aexists."

#: catalog/lab/registry.py:92
msgid "Изолированный engine: очередь, контролируемый сбой, повтор и результат. Завершается в запросе."
msgstr "An isolated engine: queue, controlled failure, retry, and result. Completes within the request."

#: catalog/lab/registry.py:99
msgid "Сгенерированный сериализатор: create, PATCH и отклонение отрицательной цены."
msgstr "A generated serializer: create, PATCH, and rejection of a negative price."

#: catalog/lab/registry.py:106
msgid "Схема формы и реальная проверка формы, собранной compile_admin."
msgstr "Inspect and validate a real form generated by compile_admin."

#: catalog/lab/registry.py:113
msgid "Настоящий OpenTelemetry span и события локального экспортера Nova Metrics."
msgstr "A real OpenTelemetry span and events from a local Nova Metrics exporter."

#: catalog/lab/registry.py:120
msgid "Round-trip, TTL и смена общего поколения на настоящем Redis."
msgstr "Round-trip, TTL, and shared generation rotation using a real Redis server."

#: catalog/lab/registry.py:128
msgid "Конкурирующие блокировки, лимит запросов и доставка сообщения через Redis."
msgstr "Competing locks, rate limiting, and message delivery through Redis."

#: catalog/lab/registry.py:136
msgid "Независимое хранение, TTL и общие поколения на настоящем Memcached."
msgstr "Independent storage, TTL, and shared generations using a real Memcached server."

#: catalog/lab/registry.py:144
msgid "Сборка роутера Nova и OpenAPI через ASGI. CRUD показан отдельно в DRF."
msgstr "Compile a Nova router and inspect OpenAPI through ASGI. CRUD is demonstrated separately with DRF."

#: catalog/lab/registry.py:153
msgid "Эксперимент: Strawberry-тип из Pydantic и выполнение ограниченного read-only запроса."
msgstr "Experimental: a Strawberry type from Pydantic and a bounded read-only query."

#: catalog/lab/registry.py:160
msgid "Миграции и routing"
msgstr "Migrations and routing"

#: catalog/lab/registry.py:162
msgid "Просмотр SQL CreateIndexConcurrently и состояния маршрутизатора. DDL и репликация не выполняются."
msgstr "Inspect CreateIndexConcurrently SQL and router state. No DDL or replication is executed."

#: catalog/lab/runner.py:99
#, python-brace-format
msgid "Настройте {variable} и запустите сервис."
msgstr "Set {variable} and start the service."

#: catalog/lab/runner.py:109
msgid "name должен быть строкой, price — строкой или числом."
msgstr "name must be a string; price must be a string or a number."

#: catalog/lab/runner.py:114
msgid "Невалидная модель не записана в БД"
msgstr "The invalid model was not written to the database"

#: catalog/lab/runner.py:121
msgid "Валидная модель записана"
msgstr "The valid model was saved"

#: catalog/lab/runner.py:122
msgid "Цена нормализована в Decimal"
msgstr "The price was normalized to Decimal"

#: catalog/lab/runner.py:142
msgid "Файл сериализован по имени, не по длине содержимого"
msgstr "The file was serialized by name, independently of its content length"

#: catalog/lab/runner.py:144
msgid "Сериализация не сохраняет модель"
msgstr "Serialization does not save the model"

#: catalog/lab/runner.py:148
msgid "Django → Pydantic → Django сохраняет данные"
msgstr "Django → Pydantic → Django preserves the data"

#: catalog/lab/runner.py:160
msgid "rows должен быть целым числом от 1 до 12"
msgstr "rows must be an integer between 1 and 12"

#: catalog/lab/runner.py:175
msgid "Обычный ORM"
msgstr "Plain ORM"

#: catalog/lab/runner.py:177
msgid "План Nova"
msgstr "Nova plan"

#: catalog/lab/runner.py:178
msgid "Результаты обоих запросов совпадают"
msgstr "Both queries return the same result"

#: catalog/lab/runner.py:179
msgid "План устраняет N+1"
msgstr "The plan eliminates N+1 queries"

#: catalog/lab/runner.py:187
msgid "MISS · чтение из БД"
msgstr "MISS · database read"

#: catalog/lab/runner.py:188
msgid "HIT · чтение из кэша"
msgstr "HIT · cache read"

#: catalog/lab/runner.py:189
msgid "Первое чтение выполняет SQL"
msgstr "The first read executes SQL"

#: catalog/lab/runner.py:190
msgid "Повторное чтение не выполняет SQL"
msgstr "The repeated read executes no SQL"

#: catalog/lab/runner.py:192
msgid "Содержимое результатов совпадает"
msgstr "The results contain the same data"

#: catalog/lab/runner.py:211
msgid "Чтение после COMMIT"
msgstr "Read after COMMIT"

#: catalog/lab/runner.py:212
msgid "Commit делает новое значение видимым"
msgstr "Commit makes the new value visible"

#: catalog/lab/runner.py:217
msgid "Чтение после ROLLBACK"
msgstr "Read after ROLLBACK"

#: catalog/lab/runner.py:218
msgid "Rollback не публикует отменённую цену"
msgstr "Rollback does not publish the reverted price"

#: catalog/lab/runner.py:219
msgid "Rollback сохраняет прежний cache hit"
msgstr "Rollback preserves the existing cache hit"

#: catalog/lab/runner.py:228
msgid "HIT до изменения связи"
msgstr "HIT before the related model changes"

#: catalog/lab/runner.py:229
msgid "Исходный результат действительно кэширован"
msgstr "The original result is confirmed to be cached"

