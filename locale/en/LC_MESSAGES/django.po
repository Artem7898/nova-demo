msgid "Исключение и отмена не меняют внешний контекст"
msgstr "Exceptions and cancellation preserve the outer context"

#: catalog/lab/runner.py:309
msgid "Исходный контекст восстановлен"
msgstr "The original context was restored"

#: catalog/lab/runner.py:325
msgid "Async ORM возвращает сохранённую модель"
msgstr "Async ORM returns the saved model"

