msgstr "The serialized value remained unchanged"

#: catalog/lab/runner.py:444
msgid "Общее поколение сменилось"
msgstr "The shared generation changed"

#: catalog/lab/runner.py:447
msgid "TTL=0 удаляет значение"
msgstr "TTL=0 removes the value"

